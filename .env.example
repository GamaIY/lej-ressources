# ---------------------------------------------------------------
# Copie ce fichier en .env.local pour le developpement local.
# Sur Vercel, ces variables se configurent dans
# Settings > Environment Variables.
# ---------------------------------------------------------------

# Journal des visites (Upstash Redis).
# NE PAS saisir a la main : ces deux variables sont ecrites automatiquement
# par Vercel quand tu connectes une base Upstash au projet
# (Storage > Create Database > Upstash for Redis > Connect).
KV_REST_API_URL=https://xxxx.upstash.io
KV_REST_API_TOKEN=xxxxxxxx

# Mot de passe de la page /journal, qui affiche les visites enregistrees.
# Celui-la, tu le choisis toi-meme. Sans lui, la page reste inaccessible.
JOURNAL_PASSWORD=choisis-un-mot-de-passe-long

# Nom affiche dans le bandeau et la page de confidentialite (optionnel)
NEXT_PUBLIC_ECOLE=LEJ
# Adresse de contact pour les demandes RGPD (optionnel mais recommande)
NEXT_PUBLIC_CONTACT_RGPD=

# --- Mode test, a retirer avant d'ouvrir le site ---------------------
# Mis a 1 : le bandeau disparait et chaque visite est enregistree sans
# demander l'accord du visiteur. A n'utiliser que tant que personne
# d'autre que toi n'accede au site.
# Pour revenir au fonctionnement normal : SUPPRIME la variable sur Vercel
# (ne la mets pas a 0, supprime-la) et redeploie.
# NEXT_PUBLIC_JOURNAL_SANS_CONSENTEMENT=1
